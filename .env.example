# PostgreSQL
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=relay;Username=relay_app;Password=replace-me;Pooling=true;Maximum Pool Size=100

# Authentication/data protection
Auth__DataProtectionKeysPath=./data/keys
Auth__DataProtectionCertificatePath=/run/secrets/relay-data-protection.pfx
Auth__DataProtectionCertificatePassword=replace-me
Auth__CookieName=relay.auth
Auth__RequireHttps=true

# CORS
Cors__AllowedOrigins__0=https://app.example.com

# Development Mailtrap only
Mail__Enabled=false
Mail__Host=sandbox.smtp.mailtrap.io
Mail__Port=2525
Mail__Username=replace-me
Mail__Password=replace-me
Mail__FromEmail=no-reply@example.com
Mail__FromName=Relay

# S3-compatible cloud storage
Storage__Bucket=relay-assets
Storage__Region=auto
Storage__ServiceUrl=
Storage__AccessKey=replace-me
Storage__SecretKey=replace-me
Storage__PublicBaseUrl=
